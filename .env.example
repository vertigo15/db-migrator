# Database Connection Defaults
# Copy this file to .env and update with your actual database credentials
# The .env file is not committed to version control for security

# Source Database Configuration
SOURCE_DB_HOST=localhost
SOURCE_DB_PORT=5432
SOURCE_DB_DATABASE=jeen_db
SOURCE_DB_USERNAME=postgres
SOURCE_DB_PASSWORD=your_password_here

# Table Prefix
TABLE_PREFIX=jeen_dev

# Target Database Configuration (optional)
TARGET_DB_HOST=localhost
TARGET_DB_PORT=5432
TARGET_DB_DATABASE=jeen_db_v5
TARGET_DB_USERNAME=postgres
TARGET_DB_PASSWORD=your_password_here

# Prompt Merger RunPod vLLM Configuration
LLM_PROVIDER_NAME=runpod_vllm
LLM_BASE_URL=https://dwami9f7b0mm0k-8000.proxy.runpod.net/v1
LLM_MODEL=openai/gpt-oss-120b
LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=4096
PROMPT_MERGER_MAX_WORKERS=4
